# Copiar a .env en la raíz del proyecto antes de desplegar.
# NUNCA subir .env al repositorio (ya está ignorado por .gitignore).

# Dominio que apunta al servidor (confirmado por el usuario).
DOMAIN=sistematizacion.itsoeh.edu.mx

# Base de datos. Cambiar POSTGRES_PASSWORD por una contraseña segura.
POSTGRES_DB=plataforma
POSTGRES_USER=plataforma
POSTGRES_PASSWORD=CambiarEstaContraseña
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Sesión (8 horas). Obligatorio: el backend falla si está vacío.
SESSION_TTL_SECONDS=28800

# Origen permitido por CORS (el mismo dominio, HTTPS).
CORS_ALLOWED_ORIGINS=https://sistematizacion.itsoeh.edu.mx

# Puertos internos de los contenedores (no se publican en el host).
BACKEND_PORT=8000
FRONTEND_PORT=5173

# URL de la API que se compila dentro del frontend (Vite build-time).
VITE_API_BASE_URL=https://sistematizacion.itsoeh.edu.mx/api/v1

# Usuarios iniciales: solo se crean si la base está vacía.
# Valores de PRUEBA: cambiarlos antes de un despliegue real.
INITIAL_ADMIN_PASSWORD=dev-admin
INITIAL_DOCENTE_PASSWORD=clave-docente
INITIAL_ESTUDIANTE_PASSWORD=clave-estudiante

# Opcional: URL completa de PostgreSQL. Si se define, tiene prioridad sobre
# las variables POSTGRES_* anteriores.
# DATABASE_URL=postgresql://usuario:password@host:5432/base

# Opcional: adaptador de dispositivo activo (simulado o mqtt). Por defecto: simulado.
# DEVICE_ADAPTER=simulado

# Solo desarrollo local (bootstrap en memoria, nunca producción):
# PLATAFORMA_DEV_ADMIN_PASSWORD=...
# PLATAFORMA_DEV_DOCENTE_PASSWORD=...
# PLATAFORMA_DEV_ESTUDIANTE_PASSWORD=...
